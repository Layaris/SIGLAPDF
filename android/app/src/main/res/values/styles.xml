<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat è richiesto da local_auth (prompt biometrico) per non crashare su Android 8 e precedenti.
         DayNight segue il tema chiaro/scuro del sistema anche nel dialogo biometrico. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sigla_paper</item>
    </style>
</resources>
